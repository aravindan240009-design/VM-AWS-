# AWS Brain Connection (OpenAI-compatible endpoint from vLLM or Ollama /v1)
LLM_BASE_URL=http://127.0.0.1:8000/v1
LLM_API_KEY=change-me-local-token
LLM_MODEL=huihui-ai/Qwen3-8B-abliterated

# Harness Behavior
APP_HOST=127.0.0.1
APP_PORT=8080
MAX_AGENT_STEPS=12
ENABLE_SHELL_TOOL=true
ENABLE_PYTHON_TOOL=true
ENABLE_WEB_TOOLS=true
FAST_NO_THINK_DEFAULT=true
