# AWS Brain Connection (OpenAI-compatible endpoint from Ollama / vLLM / llama.cpp)
# EC2 brain: http://13.210.219.189:8000/v1  (ap-southeast-2, instance i-027e3b59374cd50c6)
# Local dev:  http://127.0.0.1:8000/v1
LLM_BASE_URL=http://13.210.219.189:8000/v1
LLM_API_KEY=not-required
LLM_MODEL=llama3.2:3b

# Harness Behavior
APP_HOST=127.0.0.1
APP_PORT=8080
MAX_AGENT_STEPS=12
ENABLE_SHELL_TOOL=true
ENABLE_PYTHON_TOOL=true
ENABLE_WEB_TOOLS=true
FAST_NO_THINK_DEFAULT=true
